# Rename this file to .env and fill in your token.
# This file is excluded from Git (see .gitignore).

# Your 100xDevs session Bearer token.
# To get it: open DevTools in your browser on app.100xdevs.com,
# go to Network → any API request → copy the "Authorization" header value.
COHORT_TOKEN=Bearer <paste_your_jwt_token_here>
